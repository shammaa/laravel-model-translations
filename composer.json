{
    "name": "shammaa/laravel-model-translations",
    "description": "Smart and easy table-per-model translation system for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Shadi Shammaa",
            "email": "shadi.shammaa@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Shammaa\\LaravelModelTranslations\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shammaa\\LaravelModelTranslations\\LaravelModelTranslationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}